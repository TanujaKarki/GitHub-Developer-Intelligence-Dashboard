{
  "name": "github-dashboard-backend",
  "version": "1.0.0",
  "description": "Node.js/Express backend proxy for GitHub Developer Intelligence Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/ensureEnv.js && node server.js",
    "dev": "node scripts/ensureEnv.js && nodemon server.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 75
      }
    }
  }
}
